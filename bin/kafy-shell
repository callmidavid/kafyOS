#!/usr/bin/env bash
set -euo pipefail

command -v qs >/dev/null 2>&1 || {
  printf 'Kafy Shell requires the quickshell package.\n' >&2
  exit 1
}

case ${1:-start} in
  start) exec qs -c kafy ;;
  launcher) exec qs ipc call kafy toggleLauncher ;;
  control-center) exec qs ipc call kafy toggleControlCenter ;;
  notifications) exec qs ipc call kafy toggleNotifications ;;
  *) printf 'Usage: kafy-shell {start|launcher|control-center|notifications}\n' >&2; exit 2 ;;
esac
