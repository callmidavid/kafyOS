#!/usr/bin/env bash
set -euo pipefail

target=/mnt/archinstall

die() {
  printf 'Kafy installer: %s\n' "$*" >&2
  exit 1
}

require_root() {
  [[ ${EUID} -eq 0 ]] || die 'run this command as root'
}

select_user() {
  local users=()
  local account

  while IFS=: read -r account _ uid _ _ home _; do
    [[ $uid -ge 1000 && $uid -lt 65534 && $home == /home/* ]] || continue
    users+=("$account")
  done < "$target/etc/passwd"

  ((${#users[@]})) || die "no regular user was found in $target; create one in Archinstall first"

  if ((${#users[@]} == 1)); then
    printf '%s\n' "${users[0]}"
    return
  fi

  if command -v gum >/dev/null 2>&1; then
    printf '%s\n' "${users[@]}" | gum choose --header 'Select the Kafy desktop user:'
  else
    printf 'Multiple regular users were created. Re-run with KAFY_USER=<username>.\n' >&2
    return 1
  fi
}

require_root
command -v archinstall >/dev/null 2>&1 || die 'archinstall is not available in this live image'

printf '%s\n\n' 'Kafy uses Archinstall for disk layout and base-system installation.'
printf '%s\n' 'In Archinstall, create a regular sudo user and select the desktop packages you need.'
printf '%s\n\n' 'After it finishes, Kafy will safely apply its defaults to the installed target.'

archinstall

[[ -r "$target/etc/passwd" ]] || die "Archinstall did not leave an installed target at $target"

user=${KAFY_USER:-}
if [[ -z $user ]]; then
  user=$(select_user) || die 'could not determine the Kafy desktop user'
fi

exec /usr/local/bin/kafy-install-target --target "$target" --user "$user"
