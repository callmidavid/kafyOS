#!/usr/bin/env bash
# First-boot welcome trigger for the live desktop.
set -euo pipefail

DONE_FLAG="$HOME/.config/kafy-welcome-done"
if [[ -f "$DONE_FLAG" ]]; then
  exit 0
fi
[[ -x /usr/local/bin/kafy-installer ]] || exit 0

mkdir -p "$HOME/.config"
# Let the compositor and shell settle before the installer window appears.
sleep 1
/usr/local/bin/kafy-installer || true
touch "$DONE_FLAG"
