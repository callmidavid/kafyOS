#!/bin/sh
set -eu

missing=""

for command in lb debootstrap xorriso mksquashfs isohybrid mcopy; do
  if ! command -v "$command" >/dev/null 2>&1; then
    missing="$missing $command"
  fi
done

if [ -n "$missing" ]; then
  cat >&2 <<'EOF'
Kafy build host is missing required tools.

Install all dependencies with:

  sudo apt update
  sudo apt install -y live-build live-config live-boot debootstrap xorriso squashfs-tools \
    isolinux syslinux syslinux-common syslinux-utils mtools dosfstools librsvg2-bin \
    grub-efi-amd64-bin grub-pc-bin

Why:
  lb                   Creates the Debian live image
  debootstrap          Creates the Debian root filesystem
  xorriso / isohybrid  Creates the hybrid bootable ISO for USB & DVD
  mksquashfs           Compresses the live filesystem
  mtools / isolinux    Bootloader files and FAT manipulation
EOF
  exit 1
fi

echo "Kafy build host looks ready."
